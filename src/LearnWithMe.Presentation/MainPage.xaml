<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:LearnWithMe.Presentation.ViewModels"
             xmlns:domain="clr-namespace:LearnWithMe.Domain.Entities;assembly=LearnWithMe.Domain"
             xmlns:alphabet="clr-namespace:LearnWithMe.Application.Features.Alphabet;assembly=LearnWithMe.Application"
             xmlns:math="clr-namespace:LearnWithMe.Application.Features.Math;assembly=LearnWithMe.Application"
             x:Class="LearnWithMe.Presentation.MainPage"
             x:DataType="viewModels:HomeViewModel"
             Title="Uczę się z Tobą"
             BackgroundColor="#FFF9F0">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="22">
            <VerticalStackLayout Spacing="6">
                <Label Text="Uczę się z Tobą"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#263238"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Odkrywajcie litery razem — we własnym tempie."
                       FontSize="18"
                       TextColor="#52636B" />
            </VerticalStackLayout>

            <Border Padding="20"
                    Stroke="#E4DCCF"
                    StrokeThickness="1"
                    BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <VerticalStackLayout BindingContext="{Binding Profiles}"
                                     x:DataType="viewModels:ProfilesViewModel"
                                     Spacing="14">
                    <Label Text="Kto dziś się uczy?"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#263238" />
                    <Label Text="Profile i postępy zostają na tym urządzeniu."
                           FontSize="15"
                           TextColor="#52636B" />
                    <Label Text="Nie ma jeszcze profili. Dodaj pierwszy!"
                           IsVisible="{Binding IsEmpty}"
                           FontSize="16"
                           TextColor="#52636B" />
                    <CollectionView ItemsSource="{Binding Profiles}"
                                    SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnProfileSelectionChanged"
                                    IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}"
                                    HeightRequest="220">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="domain:ChildProfile">
                                <Border Margin="0,4"
                                        Padding="14"
                                        Stroke="#E4DCCF"
                                        StrokeThickness="1"
                                        BackgroundColor="#FFFDF9">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Label Text="{Binding Avatar}"
                                               FontSize="28"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding Name}"
                                               FontSize="20"
                                               TextColor="#263238"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand" />
                                        <Button Text="Usuń"
                                                Clicked="OnDeleteProfileClicked"
                                                BackgroundColor="#FCE8E6"
                                                TextColor="#B42318"
                                                CornerRadius="10"
                                                Padding="12,8"
                                                FontSize="14" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Entry Placeholder="Imię dziecka"
                           Text="{Binding NewProfileName}"
                           MaxLength="30"
                           ReturnType="Done" />
                    <Picker Title="Wybierz awatar (opcjonalnie)"
                            ItemsSource="{Binding AvatarOptions}"
                            SelectedItem="{Binding SelectedAvatar}" />
                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                           TextColor="#B42318"
                           FontSize="15" />
                    <Button Text="Dodaj profil"
                            Command="{Binding AddProfileCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="#276749"
                            TextColor="White"
                            FontSize="18"
                            CornerRadius="14"
                            HeightRequest="54" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Zacznijcie naukę"
                    Command="{Binding StartLearningCommand}"
                    BackgroundColor="#E7A541"
                    TextColor="#263238"
                    FontAttributes="Bold"
                    FontSize="19"
                    CornerRadius="14"
                    HeightRequest="56" />

            <Button Text="🔢 Strefa cyferek i matematyki"
                    Command="{Binding ShowMathZoneCommand}"
                    BackgroundColor="#DCEAF5"
                    TextColor="#263238"
                    FontAttributes="Bold"
                    FontSize="19"
                    CornerRadius="14"
                    HeightRequest="56" />

            <VerticalStackLayout x:Name="LearningContainer"
                                 BindingContext="{Binding Learning}"
                                 x:DataType="viewModels:AlphabetLearningViewModel"
                                 IsVisible="False"
                                 Spacing="20">
                <Border Padding="18" Stroke="#CFE5D5" BackgroundColor="#F0F8F1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding ProgressSummary}"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#276749" />
                        <Label Text="{Binding BadgeSummary}"
                               FontSize="16"
                               TextColor="#52636B" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18" Stroke="#E4DCCF" BackgroundColor="White">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Poznaj polski alfabet"
                               FontSize="23"
                               FontAttributes="Bold"
                               TextColor="#263238" />
                        <Label Text="Wybierz literę, zobacz przykład i spróbuj ją narysować."
                               FontSize="16"
                               TextColor="#52636B" />
                        <CollectionView ItemsSource="{Binding Letters}" HeightRequest="340">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="6" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="alphabet:AlphabetLetter">
                                    <Button Text="{Binding Uppercase}"
                                            Clicked="OnAlphabetLetterClicked"
                                            BackgroundColor="#EAF3EC"
                                            TextColor="#263238"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            CornerRadius="12"
                                            Margin="2"
                                            HeightRequest="52" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <VerticalStackLayout IsVisible="{Binding HasSelectedLetter}" Spacing="10">
                            <Label Text="{Binding SelectedLetter.Uppercase}"
                                   FontSize="84"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="#276749" />
                            <Label Text="{Binding SelectedLetter.Lowercase}"
                                   FontSize="42"
                                   HorizontalOptions="Center"
                                   TextColor="#52636B" />
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                                <Label Text="{Binding SelectedLetter.Illustration}"
                                       FontSize="48"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding SelectedLetter.ExampleWord}"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#263238" />
                                    <Label Text="Przykładowe słowo"
                                           FontSize="14"
                                           TextColor="#52636B" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                                <Button Text="Posłuchaj"
                                        Command="{Binding SpeakCommand}"
                                        BackgroundColor="#EAF3EC"
                                        TextColor="#276749"
                                        CornerRadius="12" />
                                <Button Text="Poznaliśmy tę literę"
                                        Command="{Binding MarkLearnedCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                        BackgroundColor="#276749"
                                        TextColor="White"
                                        CornerRadius="12" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18" Stroke="#E4DCCF" BackgroundColor="White">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Narysuj literę palcem"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#263238" />
                        <Label Text="Przesuwaj palcem po polu. Jasna litera jest podpowiedzią."
                               FontSize="15"
                               TextColor="#52636B" />
                        <GraphicsView x:Name="TracingCanvas"
                                      HeightRequest="190"
                                      BackgroundColor="#FFFDF9"
                                      SemanticProperties.Description="Pole do ćwiczenia rysowania litery palcem" />
                        <Button Text="Wyczyść rysunek"
                                Clicked="OnClearTraceClicked"
                                BackgroundColor="#EAF3EC"
                                TextColor="#276749"
                                CornerRadius="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18" Stroke="#E4DCCF" BackgroundColor="White">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Zabawa w pytania"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#263238" />
                        <Label Text="{Binding RolePrompt}"
                               FontSize="16"
                               TextColor="#52636B" />
                        <Picker Title="Wybierz rodzaj zabawy"
                                ItemsSource="{Binding ExerciseTypes}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedExercise}" />
                        <HorizontalStackLayout Spacing="10">
                            <Button Text="Nowe pytanie"
                                    Command="{Binding NewQuestionCommand}"
                                    BackgroundColor="#276749"
                                    TextColor="White"
                                    CornerRadius="12"
                                    HorizontalOptions="Fill" />
                            <Button Text="Zamień role"
                                    Command="{Binding SwitchRoleCommand}"
                                    BackgroundColor="#EAF3EC"
                                    TextColor="#276749"
                                    CornerRadius="12"
                                    HorizontalOptions="Fill" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding Question.Prompt}"
                               IsVisible="{Binding HasQuestion}"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="#263238" />
                        <FlexLayout BindableLayout.ItemsSource="{Binding Question.Options}"
                                    Wrap="Wrap"
                                    JustifyContent="SpaceAround">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Text="{Binding .}"
                                            Clicked="OnExerciseAnswerClicked"
                                            BackgroundColor="#FFF2D8"
                                            TextColor="#263238"
                                            FontSize="24"
                                            CornerRadius="14"
                                            Margin="4"
                                            MinimumWidthRequest="74"
                                            HeightRequest="58" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Label Text="{Binding Feedback}"
                               IsVisible="{Binding Feedback, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#276749" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18" Stroke="#E4DCCF" BackgroundColor="White">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Ostatnie ćwiczenia"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="#263238" />
                        <Label Text="Historia jest widoczna tylko w wybranym profilu."
                               FontSize="14"
                               TextColor="#52636B" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding History}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}"
                                           FontSize="15"
                                           TextColor="#52636B" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="MathContainer"
                                 BindingContext="{Binding Math}"
                                 x:DataType="viewModels:MathLearningViewModel"
                                 IsVisible="False"
                                 Spacing="20">
                <Border Padding="18" Stroke="#D5E4F0" BackgroundColor="#F0F7FC">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Strefa matematyki"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#263238" />
                        <Label Text="{Binding ProgressSummary}"
                               FontSize="16"
                               TextColor="#52636B" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18" Stroke="#E4DCCF" BackgroundColor="White">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Wybierz zabawę"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#263238" />
                        <Picker Title="Rodzaj ćwiczenia"
                                ItemsSource="{Binding ExerciseTypes}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedExercise}" />
                        <VerticalStackLayout IsVisible="{Binding IsNumberJourneyVisible}"
                                             Spacing="12">
                            <Border Padding="18" Stroke="#E4E8D9" BackgroundColor="#FBFCF7">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="Wasza podróż przez Cyfry"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="#355C45" />
                                    <Label Text="Poznaj zapis liczby, przeczytaj przykłady i narysuj ją palcem."
                                           FontSize="15"
                                           TextColor="#667365" />
                                    <HorizontalStackLayout Spacing="18"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center">
                                        <Label Text="{Binding Question.CorrectAnswer}"
                                               FontSize="80"
                                               FontAttributes="Bold"
                                               TextColor="#4D7850"
                                               VerticalOptions="Center" />
                                        <VerticalStackLayout Spacing="6"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Question.NumberName}"
                                                   FontSize="28"
                                                   FontAttributes="Bold"
                                                   TextColor="#263238" />
                                            <Button Text="🔊 Posłuchaj liczby"
                                                    Command="{Binding SpeakTextCommand}"
                                                    CommandParameter="{Binding Question.NumberName}"
                                                    BackgroundColor="#E8F0E3"
                                                    TextColor="#355C45"
                                                    CornerRadius="12" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                    <FlexLayout BindableLayout.ItemsSource="{Binding Question.ReadingExamples}"
                                                Wrap="Wrap"
                                                JustifyContent="SpaceAround">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="math:NumberReadingExample">
                                                <VerticalStackLayout Padding="10"
                                                                     Spacing="4"
                                                                     HorizontalOptions="Center">
                                                    <Label Text="{Binding Illustration}"
                                                           FontSize="34"
                                                           HorizontalTextAlignment="Center" />
                                                    <Label Text="{Binding Phrase}"
                                                           FontSize="15"
                                                           FontAttributes="Bold"
                                                           HorizontalTextAlignment="Center"
                                                           TextColor="#394A38" />
                                                    <Label Text="{Binding SingularPhrase}"
                                                           FontSize="12"
                                                           HorizontalTextAlignment="Center"
                                                           TextColor="#788273" />
                                                    <Button Text="Posłuchaj"
                                                            Clicked="OnNumberExampleSpeakClicked"
                                                            BackgroundColor="#F1F4EB"
                                                            TextColor="#526B4C"
                                                            CornerRadius="10"
                                                            FontSize="13" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </Border>
                            <Label Text="Narysuj tę cyfrę, prowadząc palec po jasnym śladzie."
                                   FontSize="15"
                                   TextColor="#52636B" />
                            <GraphicsView x:Name="NumberTracingCanvas"
                                          HeightRequest="190"
                                          BackgroundColor="#FFFDF9"
                                          SemanticProperties.Description="Pole do ćwiczenia rysowania cyfry" />
                            <Button Text="Wyczyść rysunek"
                                    Clicked="OnClearNumberTraceClicked"
                                    BackgroundColor="#EAF3EC"
                                    TextColor="#276749"
                                    CornerRadius="12" />
                        </VerticalStackLayout>
                        <Label Text="{Binding Question.Prompt}"
                               IsVisible="{Binding HasQuestion}"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="#263238" />
                        <Button Text="🔊 Posłuchaj zadania"
                                Command="{Binding SpeakTextCommand}"
                                CommandParameter="{Binding Question.Prompt}"
                                BackgroundColor="#F1F4EB"
                                TextColor="#526B4C"
                                CornerRadius="12" />
                        <Label Text="{Binding Question.VisualHint}"
                               IsVisible="{Binding HasQuestion}"
                               FontSize="22"
                               HorizontalTextAlignment="Center"
                               TextColor="#52636B" />
                        <FlexLayout BindableLayout.ItemsSource="{Binding Options}"
                                    Wrap="Wrap"
                                    JustifyContent="SpaceAround">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:Int32">
                                    <Button Text="{Binding .}"
                                            Clicked="OnMathAnswerClicked"
                                            IsEnabled="{Binding Source={x:Reference MathContainer}, Path=BindingContext.CanAnswerQuestion}"
                                            BackgroundColor="#DCEAF5"
                                            TextColor="#263238"
                                            FontSize="24"
                                            CornerRadius="14"
                                            Margin="4"
                                            MinimumWidthRequest="74"
                                            HeightRequest="58" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Label Text="{Binding Feedback}"
                               IsVisible="{Binding Feedback, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#276749" />
                        <Label Text="{Binding TopicProgress}"
                               FontSize="15"
                               TextColor="#52636B" />
                        <Button Text="✨ Nowe zadanie"
                                Command="{Binding NewQuestionCommand}"
                                IsEnabled="{Binding IsAnswerInProgress, Converter={StaticResource InvertedBoolConverter}}"
                                BackgroundColor="#276749"
                                TextColor="White"
                                FontSize="18"
                                CornerRadius="14"
                                HeightRequest="52" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
